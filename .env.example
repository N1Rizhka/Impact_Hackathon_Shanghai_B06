# Optional but required for real cross-device invites on Vercel:
# Create a free Upstash Redis DB (Vercel Storage marketplace) and paste:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV uses these names instead (also supported):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# OpenDev / openai-next credits (server-only — never commit real values)
# Add the same keys in Vercel → Project → Settings → Environment Variables
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-next.com/v1
OPENAI_MODEL=gpt-4o-mini
